{
    "schemaVersion": 1,
    "id": "${id}",
    "version": "${version}",
    "name": "${name}",
    "description": "Shows Discord notifications and your voice call in game, fed by the Huddle Equicord plugin.",
    "authors": [
        "brownie"
    ],
    "license": "MIT",
    "environment": "client",
    "entrypoints": {
        "client": [
            "com.huddle.Huddle"
        ]
    },
    "mixins": [
        "huddle.mixins.json"
    ],
    "depends": {
        "minecraft": "1.8.9",
        "fabricloader": ">=0.19.5",
        "oneconfigv1": ">=1.9.0",
        "fabric-language-kotlin": ">=1.14.1",
        "polycompose": ">=3.0.0"
    }
}
